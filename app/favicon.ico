<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" role="img" aria-label="Anime Plus">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#16358F"/>
      <stop offset="100%" stop-color="#070B16"/>
    </linearGradient>
  </defs>
  <rect width="48" height="48" rx="12" fill="url(#bg)"/>
  <rect x="1.5" y="1.5" width="45" height="45" rx="10.5"
        fill="none" stroke="#2F6BFF" stroke-width="2.2"/>
  <!-- Play triangle -->
  <path d="M14 13 L34 24 L14 35 Z" fill="#2F6BFF"/>
  <!-- Plus -->
  <line x1="37" y1="29" x2="37" y2="39" stroke="#5B8FFF" stroke-width="2.8" stroke-linecap="round"/>
  <line x1="32" y1="34" x2="42" y2="34" stroke="#5B8FFF" stroke-width="2.8" stroke-linecap="round"/>
</svg>

